#include <windows.h>
#include "version.h"

1 RT_MANIFEST "app.manifest"
1 ICON "app.ico"

101 RCDATA "fonts/inter-400.ttf"
102 RCDATA "fonts/inter-500.ttf"
103 RCDATA "fonts/inter-600.ttf"
104 RCDATA "fonts/inter-700.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "CodeLabs"
      VALUE "FileDescription", "Precision Fix - Otimizador de entrada e latencia"
      VALUE "ProductName", "Precision Fix"
      VALUE "InternalName", "PrecisionFix"
      VALUE "OriginalFilename", "PrecisionFix.exe"
      VALUE "LegalCopyright", "Copyright (C) CodeLabs - usecodelabs.com"
      VALUE "FileVersion", VER_STRING
      VALUE "ProductVersion", VER_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
